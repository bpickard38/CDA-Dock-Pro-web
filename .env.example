# Copy to .env.local for `vercel dev`, and add the same keys in the Vercel dashboard for production.

# Required — sends lead notification emails (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Optional — if both are set, every submission is also saved to the "Leads" table in Airtable
AIRTABLE_API_KEY=patxxxxxxxxxxxxxx
AIRTABLE_BASE_ID=appxxxxxxxxxxxxxx
